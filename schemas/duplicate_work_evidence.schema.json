{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specrail.local/schemas/duplicate_work_evidence.schema.json",
  "title": "Duplicate Work Evidence",
  "type": "object",
  "required": [
    "issue",
    "collected_at",
    "open_prs_complete",
    "open_pr_limit",
    "open_prs",
    "base_ref",
    "base_sha",
    "remote_branches",
    "retained_branch_dispositions"
  ],
  "additionalProperties": false,
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "collected_at": {
      "type": "string",
      "minLength": 1
    },
    "open_prs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "number",
          "head_ref",
          "references_issue"
        ],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "head_ref": {
            "type": "string",
            "minLength": 1
          },
          "references_issue": {
            "type": "boolean"
          }
        }
      }
    },
    "open_prs_complete": {
      "type": "boolean"
    },
    "open_pr_limit": {
      "type": "integer",
      "minimum": 1
    },
    "base_ref": {
      "type": "string",
      "const": "main"
    },
    "base_sha": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "remote_branches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "head_sha"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "head_sha": {
            "type": "string",
            "minLength": 40,
            "maxLength": 40,
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "retained_branch_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "branch",
          "head_sha",
          "disposition",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "head_sha": {
            "type": "string",
            "minLength": 40,
            "maxLength": 40,
            "pattern": "^[0-9a-f]{40}$"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "retained_non_conflicting",
              "active_duplicate",
              "needs_human"
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "kind",
              "reference",
              "recorded_at"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "maintainer_human"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "recorded_at": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
